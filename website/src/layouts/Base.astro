---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getRelease } from '../lib/release';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'TimeCheese — a desktop timesheet tracker.' } = Astro.props;

const release = await getRelease();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/changelog/`, label: 'Changelog' },
  { href: `${base}/docs/quickstart/`, label: 'Quickstart' },
  { href: `${base}/docs/getting-access/`, label: 'Getting access' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => currentPath === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="site-nav" id="site-nav">
      <div class="nav-banner bg-accent text-on-accent text-xs font-mono flex items-center gap-3 px-6 h-10 overflow-hidden whitespace-nowrap">
        <span class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">v{release.version} · auto-updates built in</span>
        <a href={`${base}/changelog/`} class="whitespace-nowrap underline underline-offset-2">What's new →</a>
        <button type="button" class="nav-banner-x ml-auto ps-3" aria-label="Dismiss">×</button>
      </div>
      <div class="nav-bar bg-paper border-b border-rule">
        <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
          <a href={`${base}/`} class="font-display text-lg">
            <span class="text-ink">Time</span><span class="text-accent">Cheese</span>
          </a>
          <ul class="hidden md:flex gap-6 text-sm">
            {nav.slice(1).map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'whitespace-nowrap transition-colors',
                    isActive(item.href)
                      ? 'text-accent underline underline-offset-4'
                      : 'text-muted hover:text-accent',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-3">
            <a
              href="https://github.com/thititongumpun/TimeCheese"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
              class="inline-flex min-h-11 items-center whitespace-nowrap text-muted hover:text-accent transition-colors"
            >
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
              </svg>
            </a>
            <button
              id="theme-toggle"
              type="button"
              aria-label="Toggle theme"
              class="inline-flex min-h-11 items-center whitespace-nowrap cursor-pointer text-muted hover:text-accent transition-colors"
            >
              <span class="theme-icon-dark">☀</span>
              <span class="theme-icon-light">☾</span>
            </button>
            <a
              href={`${base}/#download`}
              class="inline-flex items-center min-h-11 whitespace-nowrap rounded-sm bg-accent px-4 py-2 text-sm font-medium text-on-accent border border-accent-deep hover:bg-accent-deep transition-colors"
            >
              Download
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="colophon border-t border-rule mt-24">
      <div class="max-w-5xl mx-auto px-6 py-10 font-mono text-xs text-muted max-w-prose">
        <p>
          TimeCheese — desktop timesheet tracker. v{release.version}. <a href={`${base}/changelog/`} class="whitespace-nowrap hover:text-accent">Changelog</a> · <a href={`${base}/docs/quickstart/`} class="whitespace-nowrap hover:text-accent">Quickstart</a> · <a href={`${base}/docs/getting-access/`} class="whitespace-nowrap hover:text-accent">Getting access</a> · <a href="https://github.com/thititongumpun/TimeCheese" target="_blank" rel="noopener" class="whitespace-nowrap hover:text-accent">GitHub</a>. Built with Astro, Tailwind, GSAP. Internal tool; access by admin approval.
        </p>
      </div>
    </footer>

    <dialog id="lightbox" class="lightbox">
      <img id="lightbox-img" src="" alt="" />
    </dialog>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var dialog = document.getElementById('lightbox');
        var img = document.getElementById('lightbox-img');
        document.querySelectorAll('main a.shot').forEach(function (link) {
          link.addEventListener('click', function (e) {
            var thumb = link.querySelector('img');
            if (!thumb) return;
            e.preventDefault();
            img.src = link.href;
            img.alt = thumb.alt;
            dialog.showModal();
          });
        });
        dialog.addEventListener('click', function () {
          dialog.close();
        });
        dialog.addEventListener('close', function () {
          img.src = '';
          img.alt = '';
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var nav = document.getElementById('site-nav');
        var lastY = window.scrollY;
        window.addEventListener('scroll', function () {
          var y = window.scrollY;
          if (y > 48 && y > lastY) {
            nav.classList.add('is-compact');
          } else {
            nav.classList.remove('is-compact');
          }
          lastY = y;
        });
        var dismiss = document.querySelector('.nav-banner-x');
        dismiss.addEventListener('click', function () {
          document.documentElement.style.setProperty('--banner-h', '0px');
          nav.classList.add('is-dismissed');
        });
      })();
    </script>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
